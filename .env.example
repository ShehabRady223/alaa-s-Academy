# Copy to `.env` for local development. On Vercel, paste this file's contents into
# Project Settings -> Environment Variables -> "Import .env". NEVER commit the real .env.

# ---------- required ----------
# MongoDB Atlas connection string (include a database name, e.g. /alaas-academy)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/alaas-academy?retryWrites=true&w=majority
# Signs login sessions. Generate: openssl rand -base64 48
JWT_SECRET=
# Protects exam PINs. Generate: openssl rand -hex 32  (64 hex characters). Keep it stable: changing it invalidates every issued PIN.
TOKEN_ENCRYPTION_KEY=

# ---------- first teacher account (created automatically on the first request, only if no teacher exists yet) ----------
ADMIN_NAME=Alaa
ADMIN_EMAIL=
ADMIN_PASSWORD=
# After your first sign-in: change the password in Settings, then delete ADMIN_PASSWORD from the environment.

# ---------- optional ----------
# Your own domain. Leave empty on Vercel to use the *.vercel.app address automatically.
CLIENT_URL=
# More allowed site addresses, comma separated (for example a second domain)
EXTRA_ALLOWED_ORIGINS=
# Email for student invitations and password resets. Without it, the teacher copies the invite link from the screen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Alaa's Academy <no-reply@yourdomain.com>"
# Session lengths
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
REFRESH_ABSOLUTE_DAYS=30
# Local development only
PORT=4000
